# ==============================================================================
# NEUROPATH - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Panduan Instalasi Cepat:
# 1. Salin file ini menjadi .env.local:
#    cp .env.local.example .env.local   (Linux/macOS)
#    copy .env.local.example .env.local (Windows CMD/PowerShell)
#
# 2. Masukkan GROQ_API_KEY Anda di bawah ini.
#    (Dapatkan gratis di https://console.groq.com/keys)
#
# Catatan: Kredensial Firebase Client sudah terkonfigurasi di src/lib/firebase.js
# sehingga autentikasi dan database Firestore langsung aktif saat aplikasi dijalankan.
# ==============================================================================

# --- [1] AI INTERVIEW & COGNITIVE ANALYSIS ENGINE (WAJIB) ---
# Groq API Key untuk LLM kecepatan tinggi (Wawancara AI, scoring kognitif & roadmap)
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b

# --- [2] AI ROUTER / FALLBACK (OPSIONAL) ---
# Isi jika menggunakan custom AI router proxy (OpenAI-compatible)
AI_ROUTER_URL=
AI_ROUTER_KEY=
AI_ROUTER_MODEL=NeuroPath

# --- [3] LIVE JOB MATCHING API (OPSIONAL) ---
# RapidAPI JSearch key untuk pencarian lowongan kerja real-time di dashboard
JSEARCH_API_KEY=your_jsearch_api_key_here

# --- [4] BLOCKCHAIN CREDENTIAL ON-CHAIN (OPSIONAL) ---
# Digunakan untuk mencetak sertifikat digital ERC-721 di Ethereum Sepolia Testnet
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=your_minter_wallet_private_key_here